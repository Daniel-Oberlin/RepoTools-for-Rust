{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test rt and rs",
      "type": "shell",
      "command": "cargo",
      "args": [
        "test",
        "--tests",
        "--package", "rt",
        "--package", "rs"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Deploy rt and rs to ~/bin",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/deploy-rt.sh"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
